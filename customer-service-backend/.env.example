# 复制为 .env 后替换掉 key 即可运行
# cp .env.example .env

# ===== LLM（通义千问 DashScope 兼容模式，可换成任何 OpenAI 兼容服务）=====
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 电商后端：spzx（Java Spring Cloud）内部接口 =====
SPZX_ORDER_BASE_URL=http://127.0.0.1:9207
SPZX_PRODUCT_BASE_URL=http://127.0.0.1:9205

# ===== 客服自己的会话状态库 =====
DATABASE_URL=mysql+aiomysql://atguigu:Atguigu.123@127.0.0.1:3306/customer_service?charset=utf8mb4

APP_HOST=127.0.0.1
APP_PORT=18082

# ===== 知识库服务 RAG 服务（知识问答轨道）=====
RAG_SERVICE_URL=http://127.0.0.1:8001
RAG_SERVICE_TIMEOUT=120
