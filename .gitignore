# =====================================================================
#  ecommerce-ai · 根级忽略规则
# ---------------------------------------------------------------------
#  【作用范围】
#  这里只放「三个子项目通用」的忽略规则；子项目内部还有各自的
#  .gitignore，管自己那棵子树更细的专属内容。两份规则叠加生效：
#
#      .gitignore                      ← 本文件，跨项目通用
#      spzx-parent/.gitignore          ← Java / Maven / 前端构建产物
#      customer-service-backend/.gitignore ← Python 运行环境
#      knowledge-service/.gitignore    ← 模型权重、RAG 临时产物
#
#  【怎么维护】
#  1. 新规则请归入下面对应分组，不要直接堆到文件末尾；
#  2. 注释写「为什么忽略」，而不是复述规则本身；
#  3. 敏感信息规则永远放最前，改动时优先自查这一组；
#  4. 排查某个文件为何被忽略：git check-ignore -v <路径>
# =====================================================================


# ---------------------------------------------------------------------
#  1. 敏感信息 —— 绝对不能进仓库
#     理由：一旦 push 到 GitHub，之后再删除也无济于事，
#     历史里永远能翻出旧版本。.env 存着 LLM API Key、数据库密码；
#     证书/私钥文件同理。只允许提交 .env.example 模板（填占位符）。
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example          # 子项目里的模板同样放行（如 knowledge/.env.example）
*.jks
*.p12
*.pem
*.key

# ---------------------------------------------------------------------
#  2. Java / Maven 构建产物
#     理由：mvn package 的输出（target/、*.class、可执行 jar）
#     全部可由源码重新生成，入库只会让仓库无谓膨胀、合并时频繁冲突。
# ---------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
dependency-reduced-pom.xml
!.mvn/wrapper/maven-wrapper.jar   # Maven Wrapper 是源码的一部分，例外放行

# ---------------------------------------------------------------------
#  3. Python 运行环境与缓存
#     理由：.venv 是本机虚拟环境（路径写死、体积大）；
#     __pycache__ 等是解释器缓存；测试/类型检查产物同理。
#     依赖清单以 requirements.txt / pyproject.toml 为准。
# ---------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------
#  4. 前端依赖与构建输出
#     理由：node_modules 动辄几百 MB，靠 package.json + lock 还原；
#     dist/ 是 vite 打包结果，发布时重新构建即可。
# ---------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------
#  5. 本地模型权重与运行时产物
#     理由：BGE-M3 等模型单个就上 GB，且应按 README 自行下载；
#     temp_data / logs 是服务运行时写出来的中间文件，随时可再生。
#     注意：*.bin 是宽泛规则，若以后要提交某个二进制资源，
#     用 `git add -f` 强制加入，或在下面加 `!路径` 例外。
# ---------------------------------------------------------------------
models/
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.pkl
temp_data/
**/temp_data/
temp-files/
**/temp-files/
temp_dir/
md/
output/
logs/
**/logs/
*.log
*.pid

# ---------------------------------------------------------------------
#  6. IDE 与操作系统杂项
#     理由：IDE 配置含本机路径/个人布局，换个人打开必冲突；
#     系统缩略图、交换文件纯属噪音。
#     已跟踪的配置文件不受影响（gitignore 只拦新增的）。
# ---------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ---------------------------------------------------------------------
#  7. 仓库工作区的本地目录
#     理由：backup/ 是迁移时留下的镜像备份，
#     .workbuddy/ 是本地助手工作区，都与源码无关。
# ---------------------------------------------------------------------
backup/
.workbuddy/
